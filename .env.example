# BOASIS · copy to .env for local work. NEVER commit the real .env.
# On Hostinger, set these in the panel (Runtime → Environment variables) instead of a file.

# ── mail · Google Workspace SMTP relay ───────────────────────────────────────
# Not a vendor account: boasis.ae already receives on Google, so app mail goes out
# through the same Workspace, signed by the same DKIM key, at no extra cost.
#
# Leave BOTH blank to run the site without sending anything. With no credentials the
# relay works only in IP allowlist mode, which you configure in Gmail admin, not here.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Both addresses must be real mailboxes in the SAME Workspace, because the relay will
# only accept a From: inside the domains it serves. support@ also receives, so a
# customer's reply comes back to a person instead of bouncing.
MAIL_FROM=BOASIS <support@boasis.ae>
MAIL_REPLY_TO=support@boasis.ae

# Who gets the "new sign up" / "new enquiry" note. Comma separated for more than one.
# Keep every address here on boasis.ae: config/env.js warns if one is outside it.
MAIL_NOTIFY_TO=support@boasis.ae

# Leave blank in production. "[DEV] " is handy when testing against real inboxes.
MAIL_SUBJECT_PREFIX=

# 1 = do not send anything, print the mails to the log. Good for a demo on your laptop.
MAIL_DRY_RUN=0

# ── privacy ───────────────────────────────────────────────────────────────────
# Long random string. Changing it forgets every known visitor on purpose.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VISITOR_SALT=

# ── forms ─────────────────────────────────────────────────────────────────────
# ── the captcha ──
# Signs the puzzles. Set a private value on the server, or a script could mint its own.
# A third secret reads the same line: the mailbox-code tokens (lib/email-verify.js) fall
# back to CAPTCHA_SECRET, so no new variable is needed — VERIFY_SECRET exists only if you
# ever want a separate one. The boot warnings for these two are the site saying "I am
# running on the shared stand-in" — in production both must be set (Hostinger panel,
# Runtime → Environment variables; docs/CAPTCHA.md has the four steps).
CAPTCHA_SECRET=
# The search space. Half of it is the average wait, roughly a tenth of a second.
CAPTCHA_DIFFICULTY=20000
# Emergency only: 1 switches the captcha off and leaves the older traps doing the work.
CAPTCHA_DISABLED=0

# ── how many proxies sit in front of the app ──
# 1 = one proxy that appends the real client (the usual shared hosting shape).
# Too low and every visitor shares one bucket; too high and the header can be forged again.
# After a deploy, check it: curl -s https://boasis.ae/api/health  (see docs/LIMITS.md)
TRUST_PROXY=1

# ── caps for the whole site, not one visitor ──
# These cannot be moved by any header, so they hold even if a client lies about who it is.
GLOBAL_FORMS_PER_MIN=60
GLOBAL_FORMS_PER_DAY=2000
GLOBAL_CAPTCHA_PER_MIN=600
GLOBAL_VISITS_PER_MIN=900
NEW_VISITORS_PER_MIN=200

# ── how much mail the site is willing to send ──
# Past these, leads are still stored and the visitor still sees success: only sending stops.
MAIL_MAX_PER_HOUR=600
MAIL_MAX_PER_DAY=4000

SPAM_MIN_FILL_MS=3000
SPAM_MAX_AGE_MS=1800000
# 1 = turn away gmail/yahoo/icloud/... on the waitlist. Leave 0 unless you are drowning.
SPAM_BLOCK_FREE_MAIL=0

# ── the SPARK demo at /try-mira ───────────────────────────────────────────────
# Three doors and one file per person, in DATA_DIR/leads. Nothing here is required:
# the defaults are the site as it is deployed. docs/SPARK.md has the whole story.
SPARK_BRAIN_URL=https://brain.boasis.ae
# Who may call the two doors the Brain uses from a browser. Exact origins, comma separated.
SPARK_ORIGINS=https://boasis.ae,https://brain.boasis.ae
RATE_LIMIT_SPARK_PER_MIN=40

# The stand at /sharjah-next: 1 = a visitor is given a pass as well as a reference, so Mira writes the
# visit on that person's row and the stand's Google sheet can be filled from it. Off until it is asked
# for, because a rehearsal, a test run and a laptop all point at the live project from here, and none
# of them should be minting passes for people who do not exist. The mails this page can send are off by
# The three mails that page sends go the moment the form is in, once per reference, which needs no value
# here at all. SPARK_SN_MAIL=off stills them for the days the paid receipt must wait for a payment, and
# =each lets the same reference answer again while somebody reads them in an inbox.
SPARK_SN_PASS=off
# SHEET_HOOK_URL and SHEET_HOOK_KEY are set on Supabase, not here: the sheet is written by the edge
# functions, never by this host. docs/SHEET.md walks through it.

# ── the mirror: every form copied into your Supabase table ─────────────────────
# Off until the key is set, and it never changes what a visitor sees: the JSON file under
# DATA_DIR is written first, this is the copy a redeploy cannot swallow. The table is
# public.site_leads (demo/supabase/leads.sql), the door is the save-lead edge function, and
# docs/LEADS.md walks through both. Put the same long random string here and in the Supabase
# secret of the same name, and nothing else.
LEADS_PUSH_KEY=
# Where to post. Leave empty: it becomes SPARK_PROJECT_URL + /functions/v1/save-lead.
LEADS_PUSH_URL=
LEADS_PUSH_TIMEOUT_MS=2000

# Abuse limits, per visitor, per minute. The relay allows 10,000 recipients a day for the
# whole user, and a flood of junk forms would spend that on nothing.
RATE_LIMIT_FORMS_PER_MIN=8
RATE_LIMIT_VISITS_PER_MIN=60

# ── server ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Where waitlist.json / contact.json / visitors.json and the SPARK leads live. Default: ./data (gitignored,
# blocked from the web by lib/protect.js, and written 0600 so a shared box cannot read it).
# Hostinger example: /home/u123456/boasis-data
DATA_DIR=
